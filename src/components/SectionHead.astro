---
interface Props {
  index: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { index, title, href, linkLabel = "View all →" } = Astro.props;
---

<div class="section-head">
  <h2 class="section-head__title">
    <span class="section-head__idx">{index}</span>
    {title}
  </h2>
  {href && <a class="section-head__link label" href={href}>{linkLabel}</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .section-head__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-head__idx {
    margin-right: var(--space-3);
    color: var(--color-fg-faint);
  }

  .section-head__link {
    text-decoration: none;
  }

  .section-head__link:hover {
    color: var(--color-accent);
  }
</style>
