---
/**
 * An isometric "developer at a desk" scene. Everything is projected from 3D
 * coordinates at build time, so the markup is plain SVG; the motion (typing,
 * hands, steam, floating tags) is CSS only.
 */
const OX = 262;
const OY = 150;
const K = 0.866;

type V3 = [number, number, number];
const P = (x: number, y: number, z: number): [number, number] => [
  OX + (x - y) * K,
  OY + (x + y) * 0.5 - z,
];
const pt = (v: V3) => P(...v).map((n) => n.toFixed(1)).join(",");
const poly = (...vs: V3[]) => vs.map(pt).join(" ");

/** Three visible faces of an axis-aligned box. */
const box = (x: number, y: number, z: number, dx: number, dy: number, dz: number) => ({
  top: poly([x, y, z + dz], [x + dx, y, z + dz], [x + dx, y + dy, z + dz], [x, y + dy, z + dz]),
  right: poly([x + dx, y, z + dz], [x + dx, y + dy, z + dz], [x + dx, y + dy, z], [x + dx, y, z]),
  left: poly([x, y + dy, z + dz], [x + dx, y + dy, z + dz], [x + dx, y + dy, z], [x, y + dy, z]),
});

// Desk
const DW = 250;
const DD = 150;
const DZ = 66;
const DT = 8;
const desk = box(0, 0, DZ - DT, DW, DD, DT);
const legs = [
  box(DW - 14, DD - 14, 0, 8, 8, DZ - DT),
  box(DW - 14, 6, 0, 8, 8, DZ - DT),
  box(6, DD - 14, 0, 8, 8, DZ - DT),
];
const shadow = poly([-20, -10, 0], [DW + 30, -10, 0], [DW + 30, DD + 70, 0], [-20, DD + 70, 0]);

// Monitor: screen faces +y
const MX = 70;
const MY = 38;
const MW = 118;
const MH = 70;
const MZ = DZ + 26;
const bezel = box(MX, MY, MZ, MW, 5, MH);
const stand = box(MX + MW / 2 - 5, MY, DZ, 10, 6, 26);
const base = box(MX + MW / 2 - 22, MY - 6, DZ, 44, 20, 3);
const [sx, sy] = P(MX + 6, MY + 5, MZ + MH - 6);
const SCR_W = MW - 12;
const SCR_H = MH - 12;

// Keyboard on the desk top
const [kx, ky] = P(80, 82, DZ + 0.5);

// Mug
const [mx, my] = P(205, 100, DZ);

// Chair
const seat = box(86, 154, 30, 48, 46, 6);
const chairBack = box(86, 196, 36, 48, 5, 62);
const chairPost = box(106, 170, 8, 8, 8, 22);

// Person (all joints in 3D, drawn as round-capped strokes)
const hip: V3 = [110, 180, 44];
const shoulder: V3 = [110, 172, 94];
const neck: V3 = [110, 170, 106];
const headC = P(110, 166, 120);
const elbowL = P(90, 152, 78);
const elbowR = P(130, 152, 78);
const handL = P(96, 106, DZ + 4);
const handR = P(128, 106, DZ + 4);
const shoulderL = P(97, 172, 90);
const shoulderR = P(123, 172, 90);
const knee = P(110, 138, 46);
const foot = P(110, 152, 6);
const toe = P(110, 136, 4);

const seg = (a: number[], b: number[]) =>
  `M${a[0].toFixed(1)} ${a[1].toFixed(1)} L${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
const hp = P(...hip);
const sh = P(...shoulder);
const nk = P(...neck);

// Screen content
const lines = [
  { w: 34, x: 0, a: false },
  { w: 52, x: 6, a: false },
  { w: 28, x: 6, a: true },
  { w: 62, x: 12, a: false },
  { w: 40, x: 12, a: false },
  { w: 22, x: 6, a: true },
  { w: 56, x: 6, a: false },
  { w: 30, x: 0, a: false },
  { w: 46, x: 0, a: true },
];

const tags = [
  { t: "AWS", x: 6, y: 40, z: 168, w: 40, d: 0 },
  { t: "K8s", x: 36, y: 36, z: 214, w: 40, d: 0.8, hot: true },
  { t: "TF", x: 206, y: 40, z: 200, w: 34, d: 1.6 },
  { t: "CI/CD", x: 190, y: 40, z: 156, w: 50, d: 2.4 },
];
const tagTransform = (t: (typeof tags)[number]) => {
  const [e, f] = P(t.x, t.y, t.z);
  return `matrix(${K} 0.5 0 1 ${e.toFixed(1)} ${f.toFixed(1)})`;
};
---

<figure class="desk">
  <svg viewBox="25 -60 500 460" role="img" aria-label="Illustration of a developer typing code at a desk, surrounded by floating AWS, Kubernetes, Terraform and CI/CD tags.">
    <polygon class="d-shadow" points={shadow}></polygon>

    <!-- speed lines -->
    <g class="d-speed" aria-hidden="true">
      <path d="M70 70 L250 20" />
      <path d="M96 118 L320 52" />
      <path d="M300 40 L470 100" />
    </g>

    {legs.map((l) => (<g><polygon class="d-side-l" points={l.left}></polygon><polygon class="d-side-r" points={l.right}></polygon></g>))}

    <polygon class="d-chair" points={chairPost.right}></polygon>
    <polygon class="d-chair" points={chairPost.left}></polygon>
    <polygon class="d-chair" points={seat.right}></polygon>
    <polygon class="d-chair" points={seat.left}></polygon>
    <polygon class="d-chair-hi" points={seat.top}></polygon>

    <path class="d-pants" d={`${seg(hp, knee)}`} />
    <path class="d-pants" d={`${seg(knee, foot)}`} />
    <path class="d-shoe" d={`${seg(foot, toe)}`} />

    <polygon class="d-side-l" points={desk.left}></polygon>
    <polygon class="d-side-r" points={desk.right}></polygon>
    <polygon class="d-top" points={desk.top}></polygon>

    <!-- monitor -->
    <polygon class="d-dark" points={base.top}></polygon>
    <polygon class="d-dark" points={base.left}></polygon>
    <polygon class="d-dark" points={stand.right}></polygon>
    <polygon class="d-dark" points={stand.left}></polygon>
    <polygon class="d-bezel-r" points={bezel.right}></polygon>
    <polygon class="d-bezel-t" points={bezel.top}></polygon>
    <polygon class="d-bezel" points={bezel.left}></polygon>
    <g transform={`matrix(${K} 0.5 0 1 ${sx.toFixed(1)} ${sy.toFixed(1)})`}>
      <rect class="d-screen" width={SCR_W} height={SCR_H} rx="1.5" />
      <g transform="translate(7 8)">
        {lines.map((l, i) => (
          <rect
            class:list={["d-code", l.a && "d-code--hot"]}
            style={`--i:${i}`}
            x={l.x}
            y={i * 6.2}
            width={l.w}
            height="2.6"
            rx="1.3"
          />
        ))}
        <rect class="d-caret" x="0" y={lines.length * 6.2} width="3" height="3.6" />
      </g>
    </g>

    <!-- keyboard -->
    <g transform={`matrix(${K} 0.5 ${-K} 0.5 ${kx.toFixed(1)} ${ky.toFixed(1)})`}>
      <rect class="d-kb" width="76" height="26" rx="2" />
      {[0, 1, 2].map((r) =>
        Array.from({ length: 9 }, (_, c) => (
          <rect
            class="d-key"
            style={`--k:${(r * 9 + c) % 7}`}
            x={4 + c * 7.8}
            y={4 + r * 7.2}
            width="6"
            height="5.4"
            rx="1"
          />
        ))
      )}
    </g>

    <!-- mug + steam -->
    <g>
      <ellipse class="d-mug-b" cx={mx} cy={my - 6} rx="9" ry="5" />
      <rect class="d-mug" x={mx - 9} y={my - 20} width="18" height="14" />
      <ellipse class="d-mug-t" cx={mx} cy={my - 20} rx="9" ry="5" />
      <g class="d-steam">
        <path d={`M${mx - 3} ${my - 28} q-4 -7 0 -13 t0 -13`} />
        <path d={`M${mx + 3} ${my - 28} q4 -7 0 -13 t0 -13`} />
      </g>
    </g>

    <!-- chair + person (back to front) -->
    <polygon class="d-chair" points={chairBack.right}></polygon>
    <polygon class="d-chair" points={chairBack.top}></polygon>
    <polygon class="d-chair-hi" points={chairBack.left}></polygon>

    <path class="d-torso" d={seg(hp, sh)} />
    <path class="d-arm" d={`M${shoulderL[0]} ${shoulderL[1]} L${elbowL[0]} ${elbowL[1]} L${handL[0]} ${handL[1]}`} />
    <path class="d-arm" d={`M${shoulderR[0]} ${shoulderR[1]} L${elbowR[0]} ${elbowR[1]} L${handR[0]} ${handR[1]}`} />
    <circle class="d-hand d-hand--l" cx={handL[0]} cy={handL[1]} r="5" />
    <circle class="d-hand d-hand--r" cx={handR[0]} cy={handR[1]} r="5" />
    <path class="d-neck" d={seg(sh, nk)} />
    <circle class="d-skin" cx={headC[0]} cy={headC[1]} r="14" />
    <path class="d-hair" d={`M${headC[0] - 15} ${headC[1] + 2} a15 15 0 0 1 30 -4 q-9 -6 -17 -2 q-8 6 -13 6 z`} />
    <path class="d-hair" d={`M${headC[0] - 16} ${headC[1] - 2} q-1 14 10 17 q-2 -9 2 -17 z`} />
    <path class="d-glass" d={`M${headC[0] + 4} ${headC[1] + 2} h9`} />

    <!-- floating tags -->
    {tags.map((t) => (
      <g class="d-float" style={`--d:${t.d}s`}>
        <g transform={tagTransform(t)}>
          <rect class:list={["d-tag", t.hot && "d-tag--hot"]} width={t.w} height="22" rx="2" />
          <text class="d-tag-t" x={t.w / 2} y="15" text-anchor="middle">{t.t}</text>
        </g>
      </g>
    ))}
  </svg>
</figure>

<style>
  .desk {
    --skin: light-dark(#e6b8a2, #d9a58a);
    --hair: light-dark(#1a1a1a, #3d3d42);
    --sweater: light-dark(#3a3936, #5b5953);
    --pants: light-dark(#6a6862, #7d7a72);
    --shoe: light-dark(#1a1a1a, #2c2d31);
    --chair: light-dark(#1a1a1a, #2a2b30);
    --chair-hi: light-dark(#2e2d2a, #3a3b41);
    --desk-top: light-dark(#ffffff, #1c1e23);
    --desk-l: light-dark(#e3dfd6, #14161a);
    --desk-r: light-dark(#d2cec4, #0f1013);
    --dark: light-dark(#1a1a1a, #0b0c0e);
    --screen: light-dark(#faf8f5, #15171b);
    --code: light-dark(#b9b5ab, #3b3e46);
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .d-shadow { fill: var(--color-fg); opacity: 0.06; }
  .d-speed path { fill: none; stroke: var(--color-accent); stroke-width: 1.2; stroke-dasharray: 26 40; opacity: 0.35; }
  .d-top { fill: var(--desk-top); stroke: var(--color-rule-strong); stroke-width: 1; stroke-linejoin: round; }
  .d-side-l { fill: var(--desk-l); stroke: var(--color-rule-strong); stroke-width: 0.8; }
  .d-side-r { fill: var(--desk-r); stroke: var(--color-rule-strong); stroke-width: 0.8; }
  .d-dark { fill: var(--dark); }
  .d-bezel { fill: var(--dark); }
  .d-bezel-t { fill: color-mix(in oklab, var(--dark) 80%, var(--color-fg-muted)); }
  .d-bezel-r { fill: color-mix(in oklab, var(--dark) 70%, #000); }
  .d-screen { fill: var(--screen); }
  .d-code { fill: var(--code); transform-box: fill-box; transform-origin: left center; }
  .d-code--hot { fill: var(--color-accent); }
  .d-caret { fill: var(--color-accent); }
  .d-kb { fill: color-mix(in oklab, var(--desk-top) 60%, var(--desk-l)); stroke: var(--color-rule-strong); stroke-width: 0.8; }
  .d-key { fill: var(--desk-top); stroke: var(--color-rule); stroke-width: 0.5; }
  .d-mug, .d-mug-b { fill: var(--color-fg-muted); }
  .d-mug-t { fill: var(--dark); }
  .d-steam path { fill: none; stroke: var(--color-fg-faint); stroke-width: 1.6; stroke-linecap: round; opacity: 0.7; }
  .d-chair { fill: var(--chair); }
  .d-chair-hi { fill: var(--chair-hi); }
  .d-pants, .d-shoe, .d-torso, .d-arm, .d-neck { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .d-pants { stroke: var(--pants); stroke-width: 15; }
  .d-shoe { stroke: var(--shoe); stroke-width: 11; }
  .d-torso { stroke: var(--sweater); stroke-width: 27; }
  .d-arm { stroke: var(--sweater); stroke-width: 11; }
  .d-neck { stroke: var(--skin); stroke-width: 9; }
  .d-hand, .d-skin { fill: var(--skin); }
  .d-hair { fill: var(--hair); }
  .d-glass { stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; fill: none; }
  .d-tag { fill: var(--color-bg-raised); stroke: var(--color-rule-strong); stroke-width: 1; }
  .d-tag--hot { fill: var(--color-accent); stroke: var(--color-accent); }
  .d-tag-t { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; fill: var(--color-fg); }
  .d-tag--hot + .d-tag-t { fill: var(--color-accent-fg); }

  @keyframes type {
    0% { transform: scaleX(0); }
    26% { transform: scaleX(1); }
    84% { transform: scaleX(1); }
    94%, 100% { transform: scaleX(0); }
  }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes tap { to { transform: translateY(-2.5px); } }
  @keyframes key { 0%, 70%, 100% { fill: var(--desk-top); } 80% { fill: var(--color-accent); } }
  @keyframes steam {
    0% { transform: translateY(2px); opacity: 0; }
    30% { opacity: 0.7; }
    100% { transform: translateY(-7px); opacity: 0; }
  }
  @keyframes float { to { transform: translateY(-9px); } }
  @keyframes drift { to { stroke-dashoffset: -132; } }

  @media (prefers-reduced-motion: no-preference) {
    .d-code {
      transform: scaleX(0);
      animation: type 10s steps(7, end) calc(var(--i) * 0.6s) infinite both;
    }
    .d-caret { animation: blink 1s steps(1) infinite; }
    .d-hand { animation: tap 0.32s ease-in-out infinite alternate; }
    .d-hand--r { animation-duration: 0.41s; animation-delay: -0.15s; }
    .d-key { animation: key 3.4s linear infinite; animation-delay: calc(var(--k) * -0.5s); }
    .d-steam path { animation: steam 2.6s ease-out infinite; }
    .d-steam path:nth-child(2) { animation-delay: -1.3s; }
    .d-float { animation: float 3.6s ease-in-out var(--d) infinite alternate; }
    .d-speed path { animation: drift 5s linear infinite; }
  }
</style>
