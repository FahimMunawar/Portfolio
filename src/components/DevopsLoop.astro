---
/**
 * The DevOps infinity loop: a lemniscate with eight stages and a dot that
 * travels the whole path. Geometry is computed at build time, so the markup is
 * static SVG and the motion is SMIL + CSS — no client JavaScript.
 */
const stages = [
  "Plan",
  "Code",
  "Build",
  "Test",
  "Release",
  "Deploy",
  "Operate",
  "Monitor",
];

const W = 800;
const H = 300;
const CX = W / 2;
const CY = H / 2;
const A = 320;
const SQUASH = 1.35;
const SAMPLES = 480;
const DURATION = 16;

// Bernoulli lemniscate, sampled densely and walked by arc length so that the
// stage markers are evenly spaced along the line the dot actually follows.
const pts: { x: number; y: number }[] = [];
for (let i = 0; i <= SAMPLES; i++) {
  const t = Math.PI / 2 + (i / SAMPLES) * Math.PI * 2;
  const d = 1 + Math.sin(t) ** 2;
  pts.push({
    x: CX + (A * Math.cos(t)) / d,
    y: CY + (A * SQUASH * Math.sin(t) * Math.cos(t)) / d,
  });
}

const cum = [0];
for (let i = 1; i < pts.length; i++) {
  cum.push(
    cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y),
  );
}
const total = cum[cum.length - 1];

const path = pts
  .map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
  .join(" ");

const nodes = stages.map((label, k) => {
  const fraction = 1 / 16 + k / 8;
  const target = fraction * total;
  let j = 0;
  while (j < cum.length - 1 && cum[j] < target) j++;
  const p = pts[j];
  const above = p.y < CY;
  return {
    label,
    x: p.x,
    y: p.y,
    labelY: p.y + (above ? -18 : 28),
    delay: (fraction * DURATION).toFixed(2),
    side: k < 4 ? "dev" : "ops",
  };
});
---

<figure class="loop">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="The DevOps lifecycle as an infinity loop: plan, code, build, test, release, deploy, operate, monitor."
    style={`--dur:${DURATION}s`}
  >
    <path id="lemniscate" class="loop__track" d={path}></path>
    <path class="loop__flow" d={path}></path>

    <text class="loop__side" x={CX - 205} y={CY + 6} text-anchor="middle">DEV</text>
    <text class="loop__side" x={CX + 205} y={CY + 6} text-anchor="middle">OPS</text>

    {
      nodes.map((n) => (
        <g class="loop__node" style={`--delay:${n.delay}s`}>
          <circle class="loop__halo" cx={n.x} cy={n.y} r="11"></circle>
          <circle class="loop__pt" cx={n.x} cy={n.y} r="5"></circle>
          <text class="loop__label" x={n.x} y={n.labelY} text-anchor="middle">
            {n.label}
          </text>
        </g>
      ))
    }

    <g class="loop__dot">
      <circle r="9" class="loop__dot-glow"></circle>
      <circle r="4.5" class="loop__dot-core"></circle>
      <animateMotion dur={`${DURATION}s`} repeatCount="indefinite" rotate="0">
        <mpath href="#lemniscate"></mpath>
      </animateMotion>
    </g>
  </svg>
</figure>

<style>
  .loop {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .loop__track {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-width: 1.25;
  }

  .loop__flow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.25;
    stroke-dasharray: 3 14;
    opacity: 0.55;
    animation: flow 1.6s linear infinite;
  }

  .loop__side {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    fill: var(--color-fg-faint);
    opacity: 0.55;
  }

  .loop__pt {
    fill: var(--color-bg);
    stroke: var(--color-fg-muted);
    stroke-width: 1.5;
  }

  .loop__halo {
    fill: var(--color-accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .loop__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-fg-muted);
  }

  .loop__dot-glow {
    fill: var(--color-accent);
    opacity: 0.28;
  }

  .loop__dot-core {
    fill: var(--color-accent);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -34;
    }
  }

  @keyframes lit-pt {
    0%,
    2% {
      fill: var(--color-accent);
      stroke: var(--color-accent);
    }
    11% {
      fill: var(--color-accent);
      stroke: var(--color-accent);
    }
    18%,
    100% {
      fill: var(--color-bg);
      stroke: var(--color-fg-muted);
    }
  }

  @keyframes lit-halo {
    0% {
      opacity: 0.45;
      transform: scale(0.6);
    }
    14% {
      opacity: 0;
      transform: scale(2.1);
    }
    100% {
      opacity: 0;
      transform: scale(2.1);
    }
  }

  @keyframes lit-label {
    0%,
    11% {
      fill: var(--color-fg);
    }
    18%,
    100% {
      fill: var(--color-fg-muted);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .loop__pt {
      animation: lit-pt var(--dur) linear var(--delay) infinite;
    }

    .loop__halo {
      animation: lit-halo var(--dur) ease-out var(--delay) infinite;
    }

    .loop__label {
      animation: lit-label var(--dur) linear var(--delay) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop__flow {
      animation: none;
    }

    .loop__dot {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .loop__label {
      font-size: 15px;
    }

    .loop__side {
      display: none;
    }
  }
</style>
