---
/**
 * A looping CI/CD run: each stage queues, runs, then passes in turn, and the
 * connector between stages fills as the baton passes. Pure CSS; the keyframes
 * are generated here so each stage gets its own window in the 12s cycle.
 */
const stages = [
  { name: "commit", cmd: "git push origin main" },
  { name: "build", cmd: "docker build ." },
  { name: "test", cmd: "pytest · lint" },
  { name: "scan", cmd: "trivy image" },
  { name: "deploy", cmd: "helm upgrade --install" },
];

const CYCLE = 12;
const STEP = 16; // percent of the cycle between stage starts
const RUN = 9; // percent a stage spends "running"

const keyframes = stages
  .map((_, i) => {
    const s = 4 + i * STEP;
    const r = s + RUN;
    return `
@keyframes pl-stage-${i}{
  0%,${s}%{--st:0}
  ${s + 0.1}%,${r}%{--st:1}
  ${r + 0.1}%,92%{--st:2}
  96%,100%{--st:0}
}
@keyframes pl-link-${i}{
  0%,${r}%{transform:scale(0,1)}
  ${r + STEP - RUN}%,92%{transform:scale(1,1)}
  93%,100%{transform:scale(0,1)}
}
@keyframes pl-link-v-${i}{
  0%,${r}%{transform:scale(1,0)}
  ${r + STEP - RUN}%,92%{transform:scale(1,1)}
  93%,100%{transform:scale(1,0)}
}`;
  })
  .join("\n");
---

<style is:global set:html={keyframes}></style>

<ol class="pipe" style={`--cycle:${CYCLE}s`} aria-label="Example CI/CD pipeline">
  {
    stages.map((s, i) => (
      <li class="pipe__stage" style={`--i:${i}`}>
        <div class="pipe__box">
          <span class="pipe__name">{s.name}</span>
          <span class="pipe__cmd">{s.cmd}</span>
          <span class="pipe__state" aria-hidden="true">
            <span class="pipe__run">●</span>
            <span class="pipe__ok">✔</span>
          </span>
        </div>
        {i < stages.length - 1 && (
          <span class="pipe__link" aria-hidden="true">
            <span class="pipe__fill" />
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .pipe {
    display: flex;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipe__stage {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
  }

  .pipe__stage:last-child {
    flex: 0 1 auto;
  }

  /* --st: 0 queued, 1 running, 2 passed. Defaults to "passed" so reduced
     motion gets a calm, finished pipeline. */
  .pipe__box {
    --st: 2;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 8.5rem;
    padding: var(--space-3) var(--space-4);
    border: var(--rule-width) solid
      color-mix(
        in oklab,
        var(--color-accent) calc(var(--st) * 50%),
        var(--color-rule-strong)
      );
    border-radius: 4px;
    background: var(--color-bg-raised);
    font-family: var(--font-mono);
  }

  .pipe__name {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--color-fg);
  }

  .pipe__cmd {
    overflow: hidden;
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-fg-faint);
  }

  .pipe__state {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .pipe__ok,
  .pipe__run {
    position: absolute;
    top: 0;
    right: 0;
  }

  .pipe__ok {
    opacity: clamp(0, calc(var(--st) - 1), 1);
  }

  .pipe__run {
    opacity: calc(var(--st) * (2 - var(--st)));
  }

  .pipe__link {
    position: relative;
    flex: 1;
    min-width: 1rem;
    height: 2px;
    overflow: hidden;
    background: var(--color-rule-strong);
  }

  .pipe__fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pipe__box {
      animation: linear var(--cycle) infinite;
    }

    .pipe__stage:nth-child(1) .pipe__box { animation-name: pl-stage-0; }
    .pipe__stage:nth-child(2) .pipe__box { animation-name: pl-stage-1; }
    .pipe__stage:nth-child(3) .pipe__box { animation-name: pl-stage-2; }
    .pipe__stage:nth-child(4) .pipe__box { animation-name: pl-stage-3; }
    .pipe__stage:nth-child(5) .pipe__box { animation-name: pl-stage-4; }

    .pipe__fill {
      animation: linear var(--cycle) infinite;
    }

    .pipe__stage:nth-child(1) .pipe__fill { animation-name: pl-link-0; }
    .pipe__stage:nth-child(2) .pipe__fill { animation-name: pl-link-1; }
    .pipe__stage:nth-child(3) .pipe__fill { animation-name: pl-link-2; }
    .pipe__stage:nth-child(4) .pipe__fill { animation-name: pl-link-3; }
  }

  @media (max-width: 52rem) {
    .pipe {
      flex-direction: column;
      align-items: flex-start;
    }

    .pipe__stage {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    .pipe__link {
      flex: none;
      width: 2px;
      height: 1.5rem;
      margin-left: 2.5rem;
    }

    .pipe__fill {
      transform-origin: center top;
    }

    @media (prefers-reduced-motion: no-preference) {
      .pipe__stage:nth-child(1) .pipe__fill { animation-name: pl-link-v-0; }
      .pipe__stage:nth-child(2) .pipe__fill { animation-name: pl-link-v-1; }
      .pipe__stage:nth-child(3) .pipe__fill { animation-name: pl-link-v-2; }
      .pipe__stage:nth-child(4) .pipe__fill { animation-name: pl-link-v-3; }
    }
  }
</style>
